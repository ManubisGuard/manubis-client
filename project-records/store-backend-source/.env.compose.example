# For isolated test/staging deployment only. Copy to .env; never commit .env.
APP_ENV=production
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
ADMIN_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_ADMIN_TOKEN
PANEL_BASE_URL=https://vip.qoqnusradio.top
PANEL_API_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PANEL_SETTINGS_ENCRYPTION_KEY=
PANEL_TIMEOUT_SECONDS=8
# Keep the API bound to loopback until a trusted HTTPS reverse proxy is configured.
STORE_PUBLISH_HOST=127.0.0.1
STORE_PUBLISH_PORT=8091
