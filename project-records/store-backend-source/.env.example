# Copy to .env only on the backend host. Never commit .env.
APP_ENV=development
STORE_HOST=127.0.0.1
STORE_PORT=8091
PANEL_BASE_URL=https://vip.qoqnusradio.top
# Fallback key for initial setup only; rotate it and prefer dashboard-managed encrypted config.
PANEL_API_KEY=
# Required to store a dashboard-managed panel API key encrypted in PostgreSQL.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PANEL_SETTINGS_ENCRYPTION_KEY=
# Separate high-entropy token for Store Admin API; never reuse PANEL_API_KEY.
ADMIN_API_TOKEN=
PANEL_TIMEOUT_SECONDS=8
# PostgreSQL URL, e.g. postgresql+asyncpg://store_user:CHANGE_ME@127.0.0.1:5432/manubis_store
DATABASE_URL=
